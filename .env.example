# Anthropic API key used by every agent
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Local dev default is SQLite. Swap for Postgres in production, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/merakify
DATABASE_URL=sqlite+aiosqlite:///./merakify.db
