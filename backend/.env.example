# Copy to backend/.env for local dev. Never commit the real .env.
# Every key below is a DIRECT provider key — no gateway, no universal key,
# no third-party proxy for any of them. See AGENTS.md for why that matters.

# ── Core reasoning pipeline ──────────────────────────────────────────
ANTHROPIC_API_KEY=
# Opt-in evaluation until complex-story latency/quality passes the release gate.
# Uses the same model and QA; false preserves existing provider response format.
PLANNING_STRUCTURED_OUTPUTS=false

# ── Character reference images (Google AI Studio / Nano Banana) ─────
GOOGLE_AI_API_KEY=
# Nano Banana 2; configurable so a model revision does not require code changes.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Database ──────────────────────────────────────────────────────────
# Local dev uses SQLite by default. On Railway, set this to the provided
# Postgres connection string and nothing else in the code changes.
DATABASE_URL=sqlite:///./merakify.db

# ── Frontend origin allowed to call this API ─────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Dialogue voice generation ──────────────────────────────────
# Sarvam Bulbul v3 is primary for every supported language, including English.
SARVAM_API_KEY=
# ElevenLabs is a technical fallback only when Sarvam errors or times out.
ELEVENLABS_API_KEY=

# No separate post-generation lip-sync provider is used.

# ── Video generation (Render Router) ─────────────────────────────────
# Fill in whichever provider you're testing first. Don't populate all of
# these speculatively — an unused key here is a debugging trap later,
# not a convenience.
SEEDANCE_API_KEY=
# — or, if going through the EvoLink aggregator instead of direct:
EVOLINK_API_KEY=
# Used for Pixelcut product-photo preparation and fal video models.
# fal queue API, server-side only; our FAL_API_KEY maps to Authorization: Key.
# FAL_API-KEY is also accepted for existing Railway configuration.
FAL_API_KEY=
# Legacy Hedra tasks only; retained for retrieval of previously submitted jobs.
HEDRA_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────────
# Real Google OAuth, replacing Emergent's proxied login. Both required.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── AWS object storage ────────────────────────────────────────────────
# Use a dedicated IAM user scoped to GetObject/PutObject/DeleteObject on
# this bucket only. The bucket remains private.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=merakify-v2-assets
# Private objects are returned through time-limited presigned S3 URLs.
AWS_S3_PRESIGNED_URL_TTL_SEC=3600

# ── AWS async job queue (future milestone) ───────────────────────────
AWS_SQS_QUEUE_URL=

# Opt-in per-shot GFPGAN restoration; direct Replicate token.
REPLICATE_API_TOKEN=
