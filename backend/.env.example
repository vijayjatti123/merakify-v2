# Copy to backend/.env for local dev. Never commit the real .env.
# Every key below is a DIRECT provider key — no gateway, no universal key,
# no third-party proxy for any of them. See AGENTS.md for why that matters.

# ── Core reasoning pipeline ──────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Character reference images (Google AI Studio / Nano Banana) ─────
GEMINI_API_KEY=
# Nano Banana 2; configurable so a model revision does not require code changes.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Database ──────────────────────────────────────────────────────────
# Local dev uses SQLite by default. On Railway, set this to the provided
# Postgres connection string and nothing else in the code changes.
DATABASE_URL=sqlite:///./merakify.db

# ── Frontend origin allowed to call this API ─────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Indic voice (Section: Speaking Hindi, Tamil, Telugu natively) ────
# Sarvam is the default/primary voice provider for Indic dialogue.
SARVAM_API_KEY=
# ElevenLabs is the fallback — specifically for cross-lingual voice
# cloning (same character voice needed in English too).
ELEVENLABS_API_KEY=

# ── Lip sync ──────────────────────────────────────────────────────────
# Sync Labs (sync.so) — already integrated in the old codebase.
SYNC_API_KEY=
# HeyGen — keep this one filled in too if Sync Labs' audio replacement
# turns out to fully discard background music rather than mixing it;
# HeyGen's Lipsync Precision has a disable_music_track flag for exactly
# that case. Leave blank until that test is actually run.
HEYGEN_API_KEY=

# ── Video generation (Render Router) ─────────────────────────────────
# Fill in whichever provider you're testing first. Don't populate all of
# these speculatively — an unused key here is a debugging trap later,
# not a convenience.
SEEDANCE_API_KEY=
# — or, if going through the EvoLink aggregator instead of direct:
EVOLINK_API_KEY=

# ── Auth ──────────────────────────────────────────────────────────────
# Real Google OAuth, replacing Emergent's proxied login. Both required.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── AWS object storage ────────────────────────────────────────────────
# Use a dedicated IAM user scoped to GetObject/PutObject/DeleteObject on
# this bucket only. The bucket remains private.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=merakify-v2-assets
# Private objects are returned through time-limited presigned S3 URLs.
AWS_S3_PRESIGNED_URL_TTL_SEC=3600

# ── AWS async job queue (future milestone) ───────────────────────────
AWS_SQS_QUEUE_URL=
